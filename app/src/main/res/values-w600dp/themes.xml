<resources>
    <!-- Overrides Theme.MySailingLogbook.Settings (values/themes.xml's own base, see its
         comment there) on screens at least 600dp wide (tablets, or a phone in landscape past
         that width): Settings shows as a centered dialog with the main screen dimmed behind it,
         instead of the same phone-width form stretched across the full screen. Redeclares the
         base theme's own color/caps attributes directly (Android styles have single
         inheritance, so extending the Dialog theme instead of Theme.MySailingLogbook means those
         don't carry over automatically). -->
    <style name="Theme.MySailingLogbook.Settings" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">@color/app_navy</item>
        <item name="colorPrimaryVariant">@color/app_navy_dark</item>
        <item name="colorOnPrimary">@color/app_cream</item>
        <item name="colorSecondary">@color/app_navy</item>
        <item name="colorSecondaryVariant">@color/app_navy_dark</item>
        <item name="colorOnSecondary">@color/app_cream</item>
        <item name="android:textAllCaps">false</item>
        <!-- No windowMinWidthMajor/Minor here (removed): those are percentages of the long/
             short screen axis, so the same 60% meant a reasonable width in portrait but a much
             wider absolute value in landscape (found in practice, asked for explicitly to fix:
             "portrait ok, landscape too wide"). SettingsActivity.kt's own onCreate() sets a
             fixed dp width directly on the window instead, so it stays the same regardless of
             orientation. -->
    </style>
</resources>
