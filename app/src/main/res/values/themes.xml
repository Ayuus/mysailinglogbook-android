<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MySailingLogbook" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Same navy/cream pair as the app icon (asked for explicitly: no purple); one brand
             color throughout, not a separate, unrelated secondary accent. -->
        <item name="colorPrimary">@color/app_navy</item>
        <item name="colorPrimaryVariant">@color/app_navy_dark</item>
        <item name="colorOnPrimary">@color/app_cream</item>
        <item name="colorSecondary">@color/app_navy</item>
        <item name="colorSecondaryVariant">@color/app_navy_dark</item>
        <item name="colorOnSecondary">@color/app_cream</item>
        <!-- No android:statusBarColor here (removed, was ?attr/colorPrimaryVariant); deprecated
             as of Android 15's enforced edge-to-edge (this app's targetSdk is well past that
             threshold), flagged directly by Play Console's own pre-launch report. enableEdgeToEdge()
             in each Activity's onCreate() now draws the status/navigation bars transparent instead,
             with the existing WindowInsetsCompat padding (see MainActivity/SettingsActivity) still
             what actually keeps content clear of them. -->
        <!-- Material's default button style forces button text to ALL CAPS regardless of how
             it's written in code: every plain Button(context) in this app (Opslaan, the cache
             clear buttons, ...) inherits this via the theme, not via any per-button styling of
             its own. Disabled app-wide here (asked for explicitly) instead of setting
             app:textAllCaps="false" on each button individually, which would need repeating
             everywhere a Button is created and silently regress the next time a new one is
             added without it. -->
        <item name="android:textAllCaps">false</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Plain alias on narrow screens (phones): Settings stays the same full-screen Activity it
         always was. Overridden in values-w600dp/ to show as a centered dialog instead on wide
         screens/tablets, where the same full-width phone layout otherwise stretched awkwardly
         across the extra space (asked for explicitly, found in practice on a tablet in
         landscape). -->
    <style name="Theme.MySailingLogbook.Settings" parent="Theme.MySailingLogbook" />
</resources>